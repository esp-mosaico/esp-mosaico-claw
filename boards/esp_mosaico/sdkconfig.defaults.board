CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n

CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y

CONFIG_APP_CLAW_LUA_DRIVER_ADC=n
CONFIG_APP_CLAW_LUA_MODULE_MAGNETOMETER=y
CONFIG_LUA_MODULE_MAGNETOMETER_CHIP_BMM150=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
# CONFIG_BT_NIMBLE_ENABLED is not set
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
# CONFIG_BTDM_CTRL_MODE_BLE_ONLY is not set
# CONFIG_BTDM_CTRL_MODE_BTDM is not set
# CONFIG_BT_BLE_ENABLED is not set
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=y
CONFIG_BT_A2DP_CODEC_AAC_ENABLED=y
CONFIG_BT_A2DP_SEP_NUM_MAX=2
CONFIG_BT_AVRCP_ENABLED=y
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=y
# CONFIG_BT_HFP_ENABLE is not set
# CONFIG_BT_PBAC_ENABLED is not set
# CONFIG_ESP_BT_AUDIO_GMF_IO_SUPPORT is not set
CONFIG_AUDIO_DECODER_SBC_SUPPORT=y
CONFIG_AUDIO_DECODER_AAC_SUPPORT=y
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
CONFIG_MOSAIC_UI_BLUETOOTH_AUDIO=y

# ES8311 audio codec (speaker + microphone).
# CONFIG_APP_CLAW_LUA_MODULE_AUDIO=y
# CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y
# CONFIG_ESP_BOARD_DEV_AUDIO_CODEC_SUPPORT=y
# CONFIG_ESP_CODEC_DEV_ES8311_USE_DEFAULT_CALIB_IN_FLASH=y

# NAND LittleFS is mounted through the spi_nand_flash block-device layers.
CONFIG_NAND_FLASH_ENABLE_BDL=y

CONFIG_TINYUSB_CDC_ENABLED=y

# Route the interactive ESP console through the native USB Serial/JTAG port.
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y
# CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_UART_NUM=-1

CONFIG_ESP_BOARD_DEV_CAMERA_SUPPORT=y
CONFIG_APP_CLAW_LUA_MODULE_CAMERA=y
CONFIG_LUA_MODULE_VISION_COLOR_DETECT=y
CONFIG_LUA_MODULE_VISION_QRCODE_DETECT=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_JPEG_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_H264_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_SWAP_BYTE=n

CONFIG_CAMERA_OV3640=y
CONFIG_CAMERA_OV3640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV3640_DVP_YUV422_UYVY_640X480_30FPS=y
CONFIG_CAMERA_OV3640_DVP_DEFAULT_FMT_YUV422_UYVY_640X480_30FPS=y
CONFIG_CAMERA_OV3640_DVP_IF_FORMAT_INDEX_DEFAULT=3
CONFIG_LUA_MODULE_CAMERA_ENABLE_VFLIP=n
CONFIG_LUA_MODULE_CAMERA_ENABLE_HMIRROR=n



# The native 480x480 Mosaic/GSP UI owns the display on esp_mosaico.
CONFIG_APP_CLAW_MOSAIC_GSP_ENABLE=y
# Keep image decoding on the render task until the async decoder's
# app-switch lifetime synchronization is fixed.
CONFIG_ESP_GSP_ENABLE_ASYNC_DECODE=n
# Temporary device-side voice/UI validation: do not dispatch to Agent.
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_DISPLAY_SERVICE_PRESENT_TE_ENABLE=y
CONFIG_DISPLAY_SERVICE_PRESENT_TE_GPIO=43

CONFIG_SPI_FLASH_AUTO_SUSPEND=y
# default:
CONFIG_SPI_FLASH_SUSPEND_TSUS_VAL_US=50
# default:
CONFIG_SPI_FLASH_SUSPEND_TRS_VAL_US=50
