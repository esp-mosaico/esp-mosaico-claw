menu "App Config"

    config APP_CLAW_MOSAIC_GSP_ENABLE
        bool "esp-gsp Mosaic UI"
        depends on ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT
        depends on APP_CLAW_CAP_CORE
        depends on APP_CLAW_CAP_SKILL_MGR
        depends on APP_CLAW_CAP_IM_WECHAT
        select MOSAIC_UI_ENABLE
        default n
        help
            Enable the product-owned esp-gsp Mosaic UI instead of ESP-Claw's
            generic LVGL system UI. Board defaults must disable
            APP_CLAW_SYSTEM_UI_ENABLE when this option is selected.

menu "ESP-Mosaico battery gauge"
    depends on ESP_BOARD_ESP_MOSAICO

    config MOSAICO_BATTERY_OVERRIDE_CHARGE_TERMINATION
        bool "Apply characterized BQ27220 charge termination parameters"
        default n
        help
            Enable only after the cell maximum charge voltage and the charger
            termination current have been confirmed. The nominal 3.7 V / 65 mAh
            rating alone does not determine these parameters. Disabled builds
            retain the gauge's existing charge termination configuration.

    config MOSAICO_BATTERY_CHARGING_VOLTAGE_MV
        int "BQ27220 Charging Voltage (mV)"
        range 2500 4600
        default 4200
        depends on MOSAICO_BATTERY_OVERRIDE_CHARGE_TERMINATION

    config MOSAICO_BATTERY_TAPER_CURRENT_MA
        int "BQ27220 Taper Current (mA)"
        range 1 1000
        default 100
        depends on MOSAICO_BATTERY_OVERRIDE_CHARGE_TERMINATION
        help
            Gauge termination detection only; this does not set charger current.
            The default is TI's reference value, not a characterized value for
            the Mosaico cell. Match this to the cell and charger. Valid charge
            termination also requires two 40 s windows with over 0.25 mAh in
            each window, and voltage above Charging Voltage minus Taper Voltage.

    config MOSAICO_BATTERY_TAPER_VOLTAGE_MV
        int "BQ27220 Taper Voltage margin (mV)"
        range 0 1000
        default 100
        depends on MOSAICO_BATTERY_OVERRIDE_CHARGE_TERMINATION
        help
            Voltage margin below Charging Voltage, not an absolute cell voltage.
            This applies to the board's existing RAM CEDV profile 1.
endmenu

menu "Default Wi-Fi Settings"

    config APP_WIFI_SSID
        string "Default Wi-Fi SSID"
        default ""
        help
            Default Wi-Fi SSID used to populate app settings.

    config APP_WIFI_PASSWORD
        string "Default Wi-Fi password"
        default ""
        help
            Default Wi-Fi password used to populate app settings.

    config APP_WIFI_AP_SSID_PREFIX
        string "Provisioning AP SSID prefix"
        default "esp-claw"
        help
            Prefix used to build the unique provisioning AP SSID. The full
            SSID is "<prefix>-<MAC[3..5]>" (e.g. esp-claw-84AEE5).

    config APP_WIFI_AP_CHANNEL
        int "Provisioning AP channel"
        range 1 13
        default 1
        help
            Channel used by the provisioning SoftAP.

    config APP_WIFI_AP_MAX_CONN
        int "Provisioning AP max connections"
        range 1 10
        default 4
        help
            Maximum number of concurrent stations on the provisioning AP.

    config APP_WIFI_MAX_RETRY
        int "STA max retries before AP fallback"
        range 1 20
        default 5
        help
            After this many consecutive STA connection failures the device
            falls back to pure AP mode and waits for the user to provision
            new credentials.

endmenu

menu "Default Search Settings"

    config APP_SEARCH_HTTP_ALLOWLIST
        string "Default HTTP Request allowlist"
        default "*"
        help
            Default value used to populate app setting `search_http_allowlist`.
            Use `*` to allow all hosts, or a comma-separated list of domains/IPs.

            e.g. "api.example.com,*.example.org,203.0.113.10"

endmenu

endmenu
