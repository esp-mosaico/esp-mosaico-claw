{
  "schema_version": 1,
  "workspace": {
    "projects_dir": ".",
    "default_project": ".",
    "environment_file": "Environment",
    "run_dir": ".codex-runs/mosaico",
    "idf_constraint_manifest": "main/idf_component.yml"
  },
  "dependencies": {
    "bsp": "boards/esp_mosaico",
    "esp_iris": "third-party/esp-iris"
  },
  "build": {
    "runner": "builtin"
  },
  "devices": [
    {
      "id": "esp-mosaico",
